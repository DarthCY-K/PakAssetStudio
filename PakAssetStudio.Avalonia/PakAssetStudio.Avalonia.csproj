<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PakAssetStudio</RootNamespace>
    <AssemblyName>PakAssetStudio.Avalonia</AssemblyName>
    <Product>PAK Asset Studio</Product>
    <Description>PAK Asset Studio 跨平台外壳（Avalonia，Windows/macOS/Linux）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
  </ItemGroup>

  <!-- 共享核心层：Models + Services（与 WPF 版同一份源文件，LocExtension 是 WPF 专属排除） -->
  <ItemGroup>
    <Compile Include="..\PakAssetStudio\Models\**\*.cs" Link="Shared\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\PakAssetStudio\Services\*.cs"
             Exclude="..\PakAssetStudio\Services\LocExtension.cs"
             Link="Shared\Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 语言文件与 WPF 版共用 -->
  <ItemGroup>
    <Content Include="..\PakAssetStudio\Languages\*.json"
             Link="Languages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
