<Window x:Class="PakAssetStudio.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PakAssetStudio.Services"
        Title="PAK Asset Studio" Width="1280" Height="930"
        MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.Drop="Window_Drop"
        x:CompileBindings="False">

  <Window.Resources>
    <!-- 与 WPF-UI 深色主题近似的调色板 -->
    <SolidColorBrush x:Key="PasTextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="PasTextSecondaryBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="PasTextTertiaryBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="PasCardBgBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PasCardBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="PasAccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="PasRowAltBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="PasHoverBrush" Color="#14FFFFFF" />
  </Window.Resources>

  <Window.Styles>
    <!-- 卡片容器（替代 ui:Card） -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PasCardBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PasCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
    <!-- 卡片标题 -->
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 表单字段标签 -->
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource PasTextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,10,0,5" />
    </Style>
    <!-- 数据网格 -->
    <Style Selector="DataGrid.pasGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PasTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource PasRowAltBrush}" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="SelectionMode" Value="Single" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 顶部：版本 / 语言 / 状态（替代 ui:TitleBar） -->
    <Grid Margin="22,12,22,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="📦" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="PAK ASSET STUDIO" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource PasTextTertiaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox x:Name="LanguageBox" Width="116" Margin="0,0,10,0" VerticalAlignment="Center"
                  DisplayMemberBinding="{Binding Name}" SelectionChanged="LanguageBox_SelectionChanged" />
        <Border Background="#1AFFFFFF" CornerRadius="11" Padding="11,4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#35D0A5" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock x:Name="HeaderStatusText" Text="{l:Loc App_Ready}" FontSize="12"
                       Foreground="{DynamicResource PasTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="22,8,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="396" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：配置面板 -->
      <ScrollViewer Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
        <StackPanel>
          <Border Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="📁" FontSize="16" Foreground="{DynamicResource PasAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Input_Title}" Classes="cardTitle" />
              </StackPanel>

              <TextBlock Text="{l:Loc Input_GameDir}" Classes="fieldLabel" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameDirectoryBox" PlaceholderText="{l:Loc Input_GameDirPlaceholder}"
                         TextChanged="PathBox_TextChanged" />
                <Button Grid.Column="1" Margin="8,0,0,0" ToolTip.Tip="{l:Loc Input_BrowseGameTip}"
                        Click="BrowseGame_Click" Content="📂" />
              </Grid>

              <TextBlock Text="{l:Loc Input_OutputDir}" Classes="fieldLabel" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputDirectoryBox" PlaceholderText="{l:Loc Input_OutputPlaceholder}"
                         TextChanged="PathBox_TextChanged" />
                <Button Grid.Column="1" Margin="8,0,0,0" ToolTip.Tip="{l:Loc Input_BrowseOutputTip}"
                        Click="BrowseOutput_Click" Content="📂" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="⚙️" FontSize="16" Foreground="{DynamicResource PasAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Profile_Title}" Classes="cardTitle" />
              </StackPanel>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="{l:Loc Profile_Ue4Label}" Classes="fieldLabel" Margin="0" />
                    <Border x:Name="ProfileAutoHint" IsVisible="False" Margin="6,0,0,0" Padding="6,1"
                            CornerRadius="7" Background="#2A4CC2FF">
                      <TextBlock Text="{l:Loc Profile_AutoBadge}" FontSize="10"
                                 Foreground="#FFFFFFFF" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <ComboBox x:Name="GameProfileBox" IsEditable="True"
                            SelectionChanged="GameProfileBox_Changed">
                    <ComboBoxItem Content="ue4.0" /><ComboBoxItem Content="ue4.1" /><ComboBoxItem Content="ue4.2" />
                    <ComboBoxItem Content="ue4.3" /><ComboBoxItem Content="ue4.4" /><ComboBoxItem Content="ue4.5" />
                    <ComboBoxItem Content="ue4.6" /><ComboBoxItem Content="ue4.7" /><ComboBoxItem Content="ue4.8" />
                    <ComboBoxItem Content="ue4.9" /><ComboBoxItem Content="ue4.10" /><ComboBoxItem Content="ue4.11" />
                    <ComboBoxItem Content="ue4.12" /><ComboBoxItem Content="ue4.13" /><ComboBoxItem Content="ue4.14" />
                    <ComboBoxItem Content="ue4.15" /><ComboBoxItem Content="ue4.16" /><ComboBoxItem Content="ue4.17" />
                    <ComboBoxItem Content="ue4.18" /><ComboBoxItem Content="ue4.19" /><ComboBoxItem Content="ue4.20" />
                    <ComboBoxItem Content="ue4.21" /><ComboBoxItem Content="ue4.22" /><ComboBoxItem Content="ue4.23" />
                    <ComboBoxItem Content="ue4.24" /><ComboBoxItem Content="ue4.25" /><ComboBoxItem Content="ue4.26" />
                    <ComboBoxItem Content="ue4.27" />
                  </ComboBox>
                  <TextBlock x:Name="ProfileRangeHint" IsVisible="False" Margin="0,5,0,0"
                             FontSize="11" Foreground="{DynamicResource PasTextTertiaryBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{l:Loc Profile_Workers}" Classes="fieldLabel" Margin="0,0,0,5" />
                  <ComboBox x:Name="WorkersBox" SelectedIndex="3">
                    <ComboBoxItem Content="2" /><ComboBoxItem Content="4" /><ComboBoxItem Content="6" />
                    <ComboBoxItem Content="8" /><ComboBoxItem Content="12" /><ComboBoxItem Content="16" />
                  </ComboBox>
                </StackPanel>
              </Grid>

              <TextBlock Text="{l:Loc Profile_AesLabel}" Classes="fieldLabel" />
              <TextBox x:Name="AesKeyBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="64"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ToolTip.Tip="{l:Loc Profile_AesTip}"
                       TextChanged="AesKeyBox_TextChanged" />

              <ToggleSwitch x:Name="LowResourceCheck" Content="{l:Loc Profile_LowResource}" Margin="0,14,0,2"
                            ToolTip.Tip="{l:Loc Profile_LowResourceTip}" />
            </StackPanel>
          </Border>

          <Border Classes="card" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🧩" FontSize="16" Foreground="{DynamicResource PasAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{l:Loc Steps_Title}" Classes="cardTitle" />
              </StackPanel>

              <TextBlock Text="{l:Loc Steps_PresetLabel}" Classes="fieldLabel" />
              <ComboBox x:Name="PresetBox" SelectedIndex="0" SelectionChanged="PresetBox_SelectionChanged">
                <ComboBoxItem Content="{l:Loc Steps_PresetFull}" />
                <ComboBoxItem Content="{l:Loc Steps_PresetExtract}" />
                <ComboBoxItem Content="{l:Loc Steps_PresetExport}" />
                <ComboBoxItem Content="{l:Loc Steps_PresetCustom}" />
              </ComboBox>

              <TextBlock Text="{l:Loc Steps_GroupRun}" Classes="fieldLabel" />
              <ToggleSwitch x:Name="ExtractCheck" Content="{l:Loc Steps_Extract}" IsChecked="True" Margin="0,2,0,0"
                            IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="ModelsCheck" Content="{l:Loc Steps_Models}" IsChecked="True" Margin="0,8,0,0"
                            IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="TexturesCheck" Content="{l:Loc Steps_Textures}" IsChecked="True" Margin="0,8,0,0"
                            IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="AudioCheck" Content="{l:Loc Steps_Audio}" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_AudioTip}" IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="AnimationsCheck" Content="{l:Loc Steps_Animations}" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_AnimationsTip}" IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="FbxCheck" Content="{l:Loc Steps_Fbx}" IsChecked="True" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_FbxTip}"
                            IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="MergeCheck" Content="{l:Loc Steps_Merge}" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_MergeTip}" IsCheckedChanged="Option_Changed" />

              <TextBlock Text="{l:Loc Steps_GroupOutput}" Classes="fieldLabel" />
              <ToggleSwitch x:Name="KeepGltfCheck" Content="{l:Loc Steps_KeepGltf}" Margin="0,2,0,0"
                            IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="DeleteCookedCheck" Content="{l:Loc Steps_DeleteCooked}" IsChecked="True" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_DeleteCookedTip}" IsCheckedChanged="Option_Changed" />
              <ToggleSwitch x:Name="OverwriteCheck" Content="{l:Loc Steps_Overwrite}" Margin="0,8,0,0"
                            ToolTip.Tip="{l:Loc Steps_OverwriteTip}"
                            IsCheckedChanged="Option_Changed" />
            </StackPanel>
          </Border>

          <!-- 安全提示（替代 ui:InfoBar） -->
          <Border Classes="card" Margin="0,12,0,4" Background="#0D4CC2FF" BorderBrush="#334CC2FF">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="🛡️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{l:Loc Safety_Title}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{l:Loc Safety_Message}" FontSize="12"
                           Foreground="{DynamicResource PasTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 右侧：工作区 -->
      <Grid Grid.Row="0" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,2,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l:Loc Workspace_Title}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource PasTextPrimaryBrush}" />
            <TextBlock x:Name="WorkspaceSummaryText" Text="{l:Loc Workspace_SummaryEmpty}"
                       Foreground="{DynamicResource PasTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleSwitch x:Name="ShowUnsupportedCheck" Content="{l:Loc Workspace_ShowUnsupported}" Margin="0,0,16,0"
                          ToolTip.Tip="{l:Loc Workspace_ShowUnsupportedTip}"
                          IsCheckedChanged="UnsupportedFilter_Changed" />
            <Button x:Name="ScanButton" Click="Scan_Click" MinWidth="118">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc Workspace_Scan}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
          <TabItem Header="{l:Loc Tab_Paks}">
            <Grid>
              <DataGrid x:Name="PakGrid" AutoGenerateColumns="False" Classes="pasGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{l:Loc Grid_Name}" Binding="{Binding Name}" Width="2*" />
                  <DataGridTextColumn Header="{l:Loc Grid_Size}" Binding="{Binding SizeText}" Width="96" />
                  <DataGridTextColumn Header="{l:Loc Grid_Version}" Binding="{Binding Version}" Width="76" />
                  <DataGridTextColumn Header="{l:Loc Grid_Compression}" Binding="{Binding Compression}" Width="104" />
                  <DataGridTextColumn Header="{l:Loc Grid_Files}" Binding="{Binding FileCount}" Width="76" />
                  <DataGridTemplateColumn Header="{l:Loc Grid_Status}" Width="154">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Status}" TextAlignment="Center" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ScanError}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PakEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsHitTestVisible="False">
                <TextBlock Text="📦" FontSize="42" Opacity="0.55" HorizontalAlignment="Center" />
                <TextBlock x:Name="PakEmptyTitle" Text="{l:Loc Empty_Title}" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,6" Foreground="{DynamicResource PasTextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="PakEmptyHint" Text="{l:Loc Empty_Hint}" FontSize="12"
                           Foreground="{DynamicResource PasTextTertiaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="{l:Loc Tab_Log}">
            <ScrollViewer x:Name="LogScroll" Background="#0E1512" Padding="14"
                          HorizontalScrollBarVisibility="Auto">
              <ItemsControl x:Name="LogBox">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"
                               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                               TextWrapping="NoWrap" LineHeight="16" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>

      <!-- 底部：任务栏 -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="18,12"
              Background="{DynamicResource PasCardBgBrush}"
              BorderBrush="{DynamicResource PasCardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="StageText" Text="{l:Loc Stage_Idle}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource PasTextPrimaryBrush}" />
            <ProgressBar x:Name="TaskProgress" Height="6" Margin="0,9,0,0" Minimum="0" Maximum="100" Value="0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="OpenOutputButton" ToolTip.Tip="{l:Loc Btn_OpenOutputTip}"
                    Click="OpenOutput_Click" Content="📂" />
            <Button x:Name="CancelButton" Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False" MinWidth="88">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✕" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc Btn_Cancel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="StartButton" Classes="accent" Margin="8,0,0,0" Click="Start_Click" MinWidth="128">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{l:Loc Btn_Start}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
